---
import { songs } from '../data/songs';

const statusOrder = ['cold', 'dusty', 'warm', 'green'] as const;
---

<section class="card" id="tracker">
	<div class="board-head">
		<h2>Setlist board</h2>
		<label class="archive-toggle">
			<input type="checkbox" id="show-archived" />
			<span>Show archived</span>
		</label>
	</div>
	<p class="muted">Tap a status to update. Green = roots + groove + hooks from memory. Archive a song to shelve it without losing its status.</p>
	<ul class="board">
		{songs.map((s) => (
			<li data-slug={s.slug} data-archived={String(s.archived)}>
				<span class="order">{String(s.order).padStart(2, '0')}</span>
				<div class="info">
					<div class="title">
						{s.title}
						{s.tier === 'backup' && <span class="badge backup">backup</span>}
						<span class="badge archive" data-archive-badge hidden>archived</span>
					</div>
					<div class="artist">
						{s.artist}
						{s.ugTab && (
							<a href={s.ugTab} target="_blank" rel="noopener" class="ug-link">tab ↗</a>
						)}
					</div>
				</div>
				<div class="row-actions">
					<div class="status" data-status={s.status}>
						{statusOrder.map((st) => (
							<button data-set={st}>{st}</button>
						))}
					</div>
					<button class="archive-btn" type="button" data-archive aria-pressed="false">
						Archive
					</button>
				</div>
			</li>
		))}
	</ul>
</section>

<script>
	import { songs } from '../data/songs';
	import {
		computeCounts,
		heroMessage,
		isVisible,
		liveSongs,
		loadState,
		nextSong,
		saveArchived,
		saveStatus,
	} from '../lib/queue';

	const BASE_URL = import.meta.env.BASE_URL;

	// One view-state object so the two filter axes never write row.hidden
	// independently (that was the old bug: each silently clobbered the other).
	const view = { showArchived: false, statusFilter: null as string | null };

	function currentSongs() {
		return liveSongs(songs, loadState());
	}

	function applyVisibility() {
		document.querySelectorAll<HTMLElement>('#tracker [data-slug]').forEach((row) => {
			const archived = row.dataset.archived === 'true';
			const status = row.querySelector('.status')?.getAttribute('data-status') ?? '';
			row.hidden = !isVisible({
				archivedMatches: view.showArchived || !archived,
				statusMatches: !view.statusFilter || view.statusFilter === status,
			});
		});
		const board = document.getElementById('tracker');
		if (board) board.dataset.filter = view.statusFilter ?? 'all';
		syncChips();
	}

	function syncChips() {
		document.querySelectorAll<HTMLElement>('.stat-mini[data-filter]').forEach((chip) => {
			const on = chip.dataset.filter === view.statusFilter;
			chip.classList.toggle('is-active', on);
			chip.setAttribute('aria-pressed', String(on));
		});
	}

	function applyState() {
		const active = currentSongs();

		document.querySelectorAll<HTMLElement>('#tracker [data-slug]').forEach((row) => {
			const slug = row.dataset.slug!;
			const song = active.find((s) => s.slug === slug);
			if (!song) return;

			row.dataset.archived = String(song.archived);

			const statusEl = row.querySelector('.status')!;
			statusEl.setAttribute('data-status', song.status);
			row.querySelectorAll<HTMLElement>('.status button').forEach((b) => {
				b.classList.toggle('active', b.dataset.set === song.status);
			});

			const badge = row.querySelector<HTMLElement>('[data-archive-badge]');
			if (badge) badge.hidden = !song.archived;

			const btn = row.querySelector<HTMLElement>('[data-archive]');
			if (btn) {
				btn.setAttribute('aria-pressed', String(song.archived));
				btn.textContent = song.archived ? 'Unarchive' : 'Archive';
			}
		});

		renderHero(active);
		renderCounts(active);
		applyVisibility();
	}

	function renderHero(active: ReturnType<typeof currentSongs>) {
		const target = document.getElementById('what-now');
		if (!target) return;
		target.innerHTML = heroMessage(nextSong(active), BASE_URL);
	}

	function renderCounts(active: ReturnType<typeof currentSongs>) {
		const { byStatus, archived, current, greenPct } = computeCounts(active);

		for (const [status, value] of Object.entries(byStatus)) {
			const el = document.getElementById(`count-${status}`);
			if (el) el.textContent = String(value);
		}

		const fill = document.getElementById('gig-ready-fill');
		const pct = document.getElementById('gig-ready-pct');
		if (fill) fill.style.width = `${greenPct}%`;
		if (pct) pct.textContent = `${greenPct}%`;

		const archiveCount = document.getElementById('count-archived');
		if (archiveCount) archiveCount.textContent = String(archived);

		// `#count-current` is `<span class="num">{n} <small>current</small></span>`:
		// update only the leading number so the <small> label survives hydration.
		const currentCount = document.getElementById('count-current');
		if (currentCount) {
			const small = currentCount.querySelector('small');
			currentCount.textContent = String(current);
			if (small) {
				currentCount.append(' ', small);
			}
		}
	}

	document.getElementById('tracker')?.addEventListener('click', (event) => {
		const target = event.target as HTMLElement;

		const statusBtn = target.closest<HTMLElement>('.status button');
		if (statusBtn) {
			const slug = statusBtn.closest<HTMLElement>('[data-slug]')?.dataset.slug;
			const status = statusBtn.dataset.set;
			if (slug && status) saveStatus(slug, status as never);
			applyState();
			return;
		}

		const archiveBtn = target.closest<HTMLElement>('[data-archive]');
		if (archiveBtn) {
			const row = archiveBtn.closest<HTMLElement>('[data-slug]');
			if (row?.dataset.slug) saveArchived(row.dataset.slug, row.dataset.archived !== 'true');
			applyState();
		}
	});

	document.getElementById('show-archived')?.addEventListener('change', (event) => {
		view.showArchived = (event.target as HTMLInputElement).checked;
		applyVisibility();
	});

	// The dashboard's stat chips filter the board; they set this island's
	// view state instead of mutating row.hidden themselves.
	window.__setStatusFilter = (status: string | null) => {
		view.statusFilter = status;
		applyVisibility();
	};

	applyState();
</script>
