---
// ChartPlayer — Guitar Hero–style falling-note play-along for bass.
// No input: notes drop as a visual cue to play along on a real bass,
// synced to a WebAudio metronome (accented downbeats).
// Mobile-first: 4 lanes fill portrait width, large readable notes.
//
// Props: a list of tracks (each = a note sequence to loop) and a heading
// to label the track picker. Shared by warm-ups and scales.
import { STRING_COLORS, STRINGS } from '../lib/warmup';
import type { StringId } from '../lib/warmup';

interface Props {
	heading?: string;
	tracks: { id: string; label: string; notes: ({ string: StringId; fret: number } | null)[] }[];
}

const { heading = 'Pattern', tracks = [] } = Astro.props;
---

<section class="gh">
	<div class="gh-controls">
		<label class="gh-field">
			<span>{heading}</span>
			<select id="gh-exercise">
				{tracks.map((t) => (
					<option value={t.id}>{t.label}</option>
				))}
			</select>
		</label>
		<label class="gh-field">
			<span>Tempo</span>
			<select id="gh-tempo">
				<option value="60">60 bpm</option>
				<option value="70">70 bpm</option>
				<option value="80" selected>80 bpm</option>
				<option value="90">90 bpm</option>
				<option value="100">100 bpm</option>
				<option value="120">120 bpm</option>
			</select>
		</label>
		<button id="gh-start" class="gh-start">Start</button>
	</div>

	<div class="gh-stage" id="gh-stage">
		<div class="gh-lanes">
			<div class="gh-lane" data-string="E"><span class="gh-label">E</span></div>
			<div class="gh-lane" data-string="A"><span class="gh-label">A</span></div>
			<div class="gh-lane" data-string="D"><span class="gh-label">D</span></div>
			<div class="gh-lane" data-string="G"><span class="gh-label">G</span></div>
		</div>
		<div class="gh-strike"></div>
		<div class="gh-count" id="gh-count" hidden></div>
	</div>
</section>

<script define:vars={{ STRING_COLORS, STRINGS, tracks }}>
	// Plain JavaScript only — Astro <script> blocks do not strip TypeScript.
	// Data (STRING_COLORS, STRINGS, tracks) is passed in from the frontmatter.

	// note on a given beat (loops over the selected track's notes).
	function noteAtBeat(track, beat) {
		return track.notes[beat % track.notes.length];
	}

	const stage = document.getElementById('gh-stage');
	const lanesEl = stage.querySelector('.gh-lanes');
	const countEl = document.getElementById('gh-count');
	const startBtn = document.getElementById('gh-start');
	const exSel = document.getElementById('gh-exercise');
	const tempoSel = document.getElementById('gh-tempo');

	// --- Track geometry ---
	let strikeY = 0; // pixels from top of lanes where the strike line sits

	function measure() {
		strikeY = stage.clientHeight - 56; // strike line sits near the bottom, above labels
	}

	// --- Audio engine (WebAudio metronome) ---
	let audioCtx = null;
	let running = false;
	let countInActive = false; // guard so Stop during count-in is respected
	let beatIdx = 0; // absolute beat counter (clicks)
	let nextBeatTime = 0; // audio-context time of the next click
	let noteBeat = 0; // absolute beat counter (notes)
	let nextNoteTime = 0; // audio-context time of the next note to spawn
	let rafId = 0;
	let notes = [];
	let beatDur = 0.5; // seconds per beat
	const lookahead = 4; // beats of runway visible ahead

	function ensureAudio() {
		if (!audioCtx) {
			const AC = window.AudioContext || window.webkitAudioContext;
			audioCtx = new AC();
		}
	}

	function click(time, accent) {
		if (!audioCtx) return;
		const osc = audioCtx.createOscillator();
		const gain = audioCtx.createGain();
		osc.type = 'square';
		osc.frequency.value = accent ? 1200 : 880;
		gain.gain.setValueAtTime(0.4, time);
		gain.gain.exponentialRampToValueAtTime(0.001, time + 0.05);
		osc.connect(gain);
		gain.connect(audioCtx.destination);
		osc.start(time);
		osc.stop(time + 0.06);
	}

	function scheduleClick(beat, time) {
		const accent = beat % 4 === 0;
		click(time, accent);
	}

	// --- Note rendering ---
	function spawnNote(beat, time) {
		const track = tracks.find((t) => t.id === exSel.value) || tracks[0];
		const note = noteAtBeat(track, beat);
		if (!note) return; // rest — no note
		const lane = lanesEl.querySelector('[data-string="' + note.string + '"]');

		const el = document.createElement('div');
		el.className = 'gh-note';
		el.style.setProperty('--c', STRING_COLORS[note.string]);
		el.dataset.time = String(time); // absolute audio-context strike time
		el.dataset.beat = String(beat); // absolute beat index (for test identity)

		// Fret number on the block (0 = open string).
		const fret = document.createElement('span');
		fret.className = 'gh-fret';
		fret.textContent = String(note.fret);
		el.appendChild(fret);

		lane.appendChild(el);
		notes.push(el);
	}

	// Position each note based on where it sits relative to "now".
	function layoutNotes() {
		if (!running || !audioCtx) return;
		const now = audioCtx.currentTime;
		const runwayPx = strikeY - 40;
		const pxPerSec = runwayPx / (lookahead * beatDur);
		for (const note of notes) {
			const strikeTime = Number(note.dataset.time);
			const dt = strikeTime - now; // seconds until strike
			const y = strikeY - dt * pxPerSec;
			note.style.transform = 'translateY(' + y + 'px)';
			note.style.opacity = dt < -0.15 ? '0.25' : '1';
			if (dt < -0.5) note.remove();
		}
		notes = notes.filter((n) => n.isConnected);
	}

	// --- Main loop ---
	function tick() {
		if (!running || !audioCtx) return;
		const now = audioCtx.currentTime;

		// Schedule clicks a hair ahead so the audible metronome stays tight.
		while (nextBeatTime < now + 0.12) {
			scheduleClick(beatIdx, nextBeatTime);
			beatIdx++;
			nextBeatTime += beatDur;
		}

		// Spawn notes `lookahead` beats early so they have a runway to fall.
		while (nextNoteTime < now + lookahead * beatDur) {
			spawnNote(noteBeat, nextNoteTime);
			noteBeat++;
			nextNoteTime += beatDur;
		}

		layoutNotes();
		rafId = requestAnimationFrame(tick);
	}

	// --- Count-in ---
	function countIn(cb) {
		countInActive = true;
		countEl.hidden = false;
		let n = 4;
		const label = ['1', '2', '3', '4'];
		function step() {
			if (!countInActive) return; // stopped early
			if (n === 0) {
				countInActive = false;
				countEl.hidden = true;
				cb();
				return;
			}
			countEl.textContent = label[4 - n];
			if (audioCtx) click(audioCtx.currentTime + 0.01, 4 - n === 1);
			n--;
			setTimeout(step, beatDur * 1000);
		}
		step();
	}

	function stop() {
		running = false;
		countInActive = false;
		cancelAnimationFrame(rafId);
		notes.forEach((n) => n.remove());
		notes = [];
		beatIdx = 0;
		noteBeat = 0;
		countEl.hidden = true;
		startBtn.textContent = 'Start';
		startBtn.classList.remove('running');
	}

	function start() {
		ensureAudio();
		measure();
		beatDur = 60 / Number(tempoSel.value);
		startBtn.textContent = 'Stop';
		startBtn.classList.add('running');

		notes.forEach((n) => n.remove());
		notes = [];

		countIn(() => {
			if (!audioCtx) return;
			audioCtx.resume();
			running = true;
			beatIdx = 0;
			nextBeatTime = audioCtx.currentTime + 0.15;
			noteBeat = 0;
			// Offset notes by a full runway so the first note starts at the top,
			// not already at the strike line. "Hard to get started when you're
			// already losing."
			nextNoteTime = nextBeatTime + lookahead * beatDur;
			rafId = requestAnimationFrame(tick);
		});
	}

	startBtn.addEventListener('click', () => {
		if (running) stop();
		else start();
	});

	window.addEventListener('resize', measure);
	measure();

	// Color the lane labels.
	lanesEl.querySelectorAll('.gh-lane').forEach((lane) => {
		const str = lane.dataset.string;
		lane.style.setProperty('--c', STRING_COLORS[str]);
	});
</script>

<style>
	.gh {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	.gh-controls {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
		align-items: flex-end;
	}
	.gh-field {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		font-size: 0.8rem;
		color: var(--muted);
	}
	.gh-field select {
		background: var(--panel-2);
		color: var(--ink);
		border: 1px solid var(--rule);
		border-radius: 6px;
		padding: 0.45rem 0.6rem;
		font-size: 0.95rem;
	}
	.gh-start {
		background: var(--accent-2);
		color: #0a120c;
		border: none;
		border-radius: 8px;
		padding: 0.6rem 1.4rem;
		font-size: 1rem;
		font-weight: 700;
		cursor: pointer;
	}
	.gh-start.running {
		background: var(--red);
		color: #160a0a;
	}

	.gh-stage {
		position: relative;
		height: 60vh;
		min-height: 320px;
		max-height: 560px;
		background: var(--panel);
		border: 1px solid var(--rule);
		border-radius: 10px;
		overflow: hidden;
	}
	.gh-lanes {
		position: absolute;
		inset: 0;
		display: flex;
	}
	.gh-lane {
		position: relative;
		flex: 1;
		border-right: 1px solid var(--rule);
		overflow: hidden;
	}
	.gh-lane:last-child {
		border-right: none;
	}
	.gh-label {
		position: absolute;
		bottom: 0.5rem;
		left: 0;
		right: 0;
		text-align: center;
		font-size: 0.8rem;
		font-weight: 700;
		color: var(--c);
		opacity: 0.8;
	}
	.gh-strike {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 56px;
		height: 2px;
		background: var(--ink);
		opacity: 0.5;
		box-shadow: 0 0 6px rgba(255, 255, 255, 0.4);
	}

	/* Dynamically-created notes carry no scoped id, so use :global. */
	:global(.gh-note) {
		position: absolute;
		top: 0;
		left: 6%;
		width: 88%;
		height: 22px;
		border-radius: 6px;
		background: linear-gradient(180deg, var(--c), color-mix(in srgb, var(--c) 60%, black));
		border: 1px solid rgba(255, 255, 255, 0.25);
		box-shadow: 0 0 8px color-mix(in srgb, var(--c) 60%, transparent);
		will-change: transform, opacity;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	/* Fret number inside each note (0 = open string). */
	:global(.gh-fret) {
		font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
		font-size: 0.75rem;
		font-weight: 700;
		line-height: 1;
		color: rgba(255, 255, 255, 0.95);
		text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
		pointer-events: none;
		user-select: none;
	}

	.gh-count {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		font-size: 4rem;
		font-weight: 800;
		color: var(--ink);
		text-shadow: 0 0 20px var(--accent);
		pointer-events: none;
	}

	@media (min-width: 720px) {
		:global(.gh-note) { height: 26px; }
	}

	@media (max-width: 480px) {
		.gh-controls { flex-direction: column; align-items: stretch; }
		.gh-field { flex: 1; }
		.gh-field select { width: 100%; font-size: 1rem; padding: 0.6rem; }
		.gh-start { width: 100%; min-height: 48px; font-size: 1.1rem; }
		.gh-stage { height: 50vh; min-height: 280px; }
		:global(.gh-note) { height: 20px; }
	}
</style>
