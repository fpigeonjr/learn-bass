---
// ChartPlayer — Guitar Hero–style falling-note play-along for bass.
// No input: notes drop as a visual cue to play along on a real bass,
// synced to a WebAudio metronome (accented downbeats).
// Mobile-first: 4 lanes fill portrait width, large readable notes.
//
// Props: a list of tracks (each = a note sequence to loop) and a heading
// to label the track picker. Shared by warm-ups and scales.
import { RUNWAY_TOP_PX, STRING_COLORS, STRIKE_LINE_BOTTOM_PX, strikeLineY } from '../lib/warmup';
import type { StringId } from '../lib/warmup';

interface Props {
	heading?: string;
	tracks: { id: string; label: string; group?: string; notes: ({ string: StringId; fret: number; boxStart?: boolean } | null)[] }[];
}

const { heading = 'Pattern', tracks = [] } = Astro.props;

// Ungrouped tracks first, then optgroups in first-appearance order.
const plain = tracks.filter((t) => !t.group);
const groups = [...new Set(tracks.filter((t) => t.group).map((t) => t.group!))].map((g) => ({
	name: g,
	tracks: tracks.filter((t) => t.group === g),
}));
---

<section class="gh">
	<div class="gh-controls">
		<label class="gh-field">
			<span>{heading}</span>
			<select id="gh-exercise">
				{plain.map((t) => (
					<option value={t.id}>{t.label}</option>
				))}
				{groups.map((g) => (
					<optgroup label={g.name}>
						{g.tracks.map((t) => (
							<option value={t.id}>{t.label}</option>
						))}
					</optgroup>
				))}
			</select>
		</label>
		<label class="gh-field">
			<span>Tempo</span>
			<select id="gh-tempo">
				<option value="60">60 bpm</option>
				<option value="70">70 bpm</option>
				<option value="80" selected>80 bpm</option>
				<option value="90">90 bpm</option>
				<option value="100">100 bpm</option>
				<option value="120">120 bpm</option>
			</select>
		</label>
		<button id="gh-start" class="gh-start">Start</button>
	</div>

	<div class="gh-stage" id="gh-stage">
		<div class="gh-lanes">
			<div class="gh-lane" data-string="E"><span class="gh-label">E</span></div>
			<div class="gh-lane" data-string="A"><span class="gh-label">A</span></div>
			<div class="gh-lane" data-string="D"><span class="gh-label">D</span></div>
			<div class="gh-lane" data-string="G"><span class="gh-label">G</span></div>
		</div>
		<div class="gh-strike"></div>
		<div class="gh-count" id="gh-count" hidden></div>
	</div>
	<script type="application/json" id="gh-tracks" set:html={JSON.stringify(tracks)} />
</section>

<script>
	// Bundled module script — imports the tested timing logic from the lib so
	// there is a single source of truth for note positioning.
	import { RUNWAY_TOP_PX, STRING_COLORS, STRIKE_LINE_BOTTOM_PX, layOutNote, strikeLineY } from '../lib/warmup';
	import type { Slot } from '../lib/warmup';

	interface Track {
		id: string;
		label: string;
		notes: Slot[];
	}

	// Tracks are serialized into a JSON island above (module scripts can't
	// receive define:vars). "note on a given beat" — loops over the track.
	function noteAtBeat(track: Track, beat: number): Slot {
		return track.notes[beat % track.notes.length];
	}

	const stage = document.getElementById('gh-stage')!;
	const tracks: Track[] = JSON.parse(document.getElementById('gh-tracks')!.textContent || '[]');
	const lanesEl = stage.querySelector('.gh-lanes')!;
	const countEl = document.getElementById('gh-count')!;
	const startBtn = document.getElementById('gh-start')!;
	const exSel = document.getElementById('gh-exercise') as HTMLSelectElement;
	const tempoSel = document.getElementById('gh-tempo') as HTMLSelectElement;

	// --- Track geometry ---
	let strikeY = 0; // pixels from top of lanes where the strike line sits

	function measure() {
		// Match .gh-strike { bottom: STRIKE_LINE_BOTTOM_PX } — use the line's
		// center so notes align with it, not its top edge.
		strikeY = strikeLineY(stage.clientHeight);
	}

	// --- Audio engine (WebAudio metronome) ---
	let audioCtx = null;
	let running = false;
	let countInActive = false; // guard so Stop during count-in is respected
	let beatIdx = 0; // absolute beat counter (clicks)
	let nextBeatTime = 0; // audio-context time of the next click
	let noteBeat = 0; // absolute beat counter (notes)
	let nextNoteTime = 0; // audio-context time of the next note to spawn
	let rafId = 0;
	let notes = [];
	let beatDur = 0.5; // seconds per beat
	let bpm = 80;
	const lookahead = 4; // beats of runway visible ahead

	function ensureAudio() {
		if (!audioCtx) {
			const AC = window.AudioContext || window.webkitAudioContext;
			audioCtx = new AC();
		}
	}

	function click(time, accent) {
		if (!audioCtx) return;
		const osc = audioCtx.createOscillator();
		const gain = audioCtx.createGain();
		osc.type = 'square';
		osc.frequency.value = accent ? 1200 : 880;
		gain.gain.setValueAtTime(0.4, time);
		gain.gain.exponentialRampToValueAtTime(0.001, time + 0.05);
		osc.connect(gain);
		gain.connect(audioCtx.destination);
		osc.start(time);
		osc.stop(time + 0.06);
	}

	function scheduleClick(beat, time) {
		const accent = beat % 4 === 0;
		click(time, accent);
	}

	// --- Note rendering ---
	function spawnNote(beat, time) {
		const track = tracks.find((t) => t.id === exSel.value) || tracks[0];
		const note = noteAtBeat(track, beat);
		if (!note) return; // rest — no note
		const lane = lanesEl.querySelector('[data-string="' + note.string + '"]');

		const el = document.createElement('div');
		el.className = 'gh-note' + (note.boxStart ? ' gh-note--box-start' : '');
		el.style.setProperty('--c', STRING_COLORS[note.string]);
		el.dataset.time = String(time); // absolute audio-context strike time
		el.dataset.beat = String(beat); // absolute beat index (for test identity)
		if (note.boxStart) el.dataset.box = '2';

		// Fret number on the block (0 = open string).
		const fret = document.createElement('span');
		fret.className = 'gh-fret';
		fret.textContent = String(note.fret);
		el.appendChild(fret);

		lane.appendChild(el);
		notes.push(el);
	}

	// Position each note based on where it sits relative to "now". Delegates
	// the math to layOutNote() so the note is centered on the strike line at
	// the exact moment the metronome click sounds.
	function layoutNotes() {
		if (!running || !audioCtx) return;
		const now = audioCtx.currentTime;
		const runwayPx = strikeY - RUNWAY_TOP_PX;
		for (const note of notes) {
			const layout = layOutNote({
				strikeTime: Number(note.dataset.time),
				now,
				strikeY,
				runwayPx,
				lookaheadBeats: lookahead,
				bpm,
				noteHeight: note.offsetHeight,
			});
			note.style.transform = 'translateY(' + layout.y + 'px)';
			note.style.opacity = String(layout.opacity);
			if (layout.expired) note.remove();
		}
		notes = notes.filter((n) => n.isConnected);
	}

	// --- Main loop ---
	function tick() {
		if (!running || !audioCtx) return;
		const now = audioCtx.currentTime;

		// Schedule clicks a hair ahead so the audible metronome stays tight.
		while (nextBeatTime < now + 0.12) {
			scheduleClick(beatIdx, nextBeatTime);
			beatIdx++;
			nextBeatTime += beatDur;
		}

		// Spawn notes `lookahead` beats early so they have a runway to fall.
		while (nextNoteTime < now + lookahead * beatDur) {
			spawnNote(noteBeat, nextNoteTime);
			noteBeat++;
			nextNoteTime += beatDur;
		}

		layoutNotes();
		rafId = requestAnimationFrame(tick);
	}

	// --- Count-in ---
	function countIn(cb) {
		countInActive = true;
		countEl.hidden = false;
		let n = 4;
		const label = ['1', '2', '3', '4'];
		function step() {
			if (!countInActive) return; // stopped early
			if (n === 0) {
				countInActive = false;
				countEl.hidden = true;
				cb();
				return;
			}
			countEl.textContent = label[4 - n];
			if (audioCtx) click(audioCtx.currentTime + 0.01, 4 - n === 1);
			n--;
			setTimeout(step, beatDur * 1000);
		}
		step();
	}

	function stop() {
		running = false;
		countInActive = false;
		cancelAnimationFrame(rafId);
		notes.forEach((n) => n.remove());
		notes = [];
		beatIdx = 0;
		noteBeat = 0;
		countEl.hidden = true;
		startBtn.textContent = 'Start';
		startBtn.classList.remove('running');
	}

	function start() {
		ensureAudio();
		measure();
		bpm = Number(tempoSel.value);
		beatDur = 60 / bpm;
		startBtn.textContent = 'Stop';
		startBtn.classList.add('running');

		notes.forEach((n) => n.remove());
		notes = [];

		countIn(() => {
			if (!audioCtx) return;
			audioCtx.resume();
			running = true;
			beatIdx = 0;
			nextBeatTime = audioCtx.currentTime + 0.15;
			noteBeat = 0;
			// Offset notes by a full runway so the first note starts at the top,
			// not already at the strike line. "Hard to get started when you're
			// already losing."
			nextNoteTime = nextBeatTime + lookahead * beatDur;
			rafId = requestAnimationFrame(tick);
		});
	}

	startBtn.addEventListener('click', () => {
		if (running) stop();
		else start();
	});

	window.addEventListener('resize', measure);
	measure();

	// Color the lane labels.
	lanesEl.querySelectorAll('.gh-lane').forEach((lane) => {
		const str = lane.dataset.string;
		lane.style.setProperty('--c', STRING_COLORS[str]);
	});
</script>

<style>
	.gh {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	.gh-controls {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
		align-items: flex-end;
	}
	.gh-field {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		font-size: 0.8rem;
		color: var(--muted);
	}
	.gh-field select {
		background: var(--panel-2);
		color: var(--ink);
		border: 1px solid var(--rule);
		border-radius: 6px;
		padding: 0.45rem 0.6rem;
		font-size: 0.95rem;
	}
	.gh-start {
		font-family: 'Bungee', sans-serif;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		background: linear-gradient(180deg, #3ee08a 0%, #1db86a 100%);
		color: #07120a;
		border: 2px solid rgba(255,255,255,0.45);
		border-radius: 999px;
		padding: 0.7rem 1.8rem;
		font-size: 1.05rem;
		font-weight: 400;
		cursor: pointer;
		box-shadow: 0 0 18px rgba(46,184,114,0.55), 0 4px 14px rgba(0,0,0,0.45), inset 0 1px 0 rgba(255,255,255,0.5);
	}
	.gh-start:hover { transform: translateY(-1px); box-shadow: 0 0 24px rgba(46,184,114,0.7), 0 6px 18px rgba(0,0,0,0.5); }
	.gh-start.running {
		background: linear-gradient(180deg, #ff4d5e 0%, #e00a20 100%);
		color: #fff;
		border-color: rgba(255,255,255,0.55);
		box-shadow: 0 0 18px rgba(255,26,46,0.65), 0 4px 14px rgba(0,0,0,0.45), inset 0 1px 0 rgba(255,255,255,0.4);
		text-shadow: 0 1px 2px rgba(0,0,0,0.4);
	}

	.gh-stage {
		position: relative;
		height: 60vh;
		min-height: 320px;
		max-height: 560px;
		background: var(--panel);
		border: 1px solid var(--rule);
		border-radius: 10px;
		overflow: hidden;
	}
	.gh-lanes {
		position: absolute;
		inset: 0;
		display: flex;
	}
	.gh-lane {
		position: relative;
		flex: 1;
		border-right: 1px solid var(--rule);
		overflow: hidden;
	}
	.gh-lane:last-child {
		border-right: none;
	}
	.gh-label {
		position: absolute;
		bottom: 0.5rem;
		left: 0;
		right: 0;
		text-align: center;
		font-size: 0.8rem;
		font-weight: 700;
		color: var(--c);
		opacity: 0.8;
	}
	.gh-strike {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 56px;
		height: 2px;
		background: var(--ink);
		opacity: 0.5;
		box-shadow: 0 0 6px rgba(255, 255, 255, 0.4);
	}

	/* Dynamically-created notes carry no scoped id, so use :global. */
	:global(.gh-note) {
		position: absolute;
		top: 0;
		left: 6%;
		width: 88%;
		height: 22px;
		border-radius: 6px;
		background: linear-gradient(180deg, var(--c), color-mix(in srgb, var(--c) 60%, black));
		border: 1px solid rgba(255, 255, 255, 0.25);
		box-shadow: 0 0 8px color-mix(in srgb, var(--c) 60%, transparent);
		will-change: transform, opacity;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	/* Box shift — only the first note of the high position flashes. */
	:global(.gh-note--box-start) {
		border-color: #f0c040 !important;
		box-shadow:
			0 0 14px color-mix(in srgb, var(--c) 55%, transparent),
			0 0 0 1.5px rgba(240, 192, 64, 1) inset,
			0 0 18px rgba(240, 192, 64, 0.5) !important;
		animation: gh-box-flash 0.9s ease-in-out infinite alternate;
	}
	:global(.gh-note--box-start .gh-fret)::after {
		content: ' ↑';
		font-size: 0.6rem;
		opacity: 0.95;
	}
	@keyframes gh-box-flash {
		from { box-shadow: 0 0 14px rgba(240, 192, 64, 0.35), 0 0 0 1.5px rgba(240, 192, 64, 1) inset; }
		to { box-shadow: 0 0 22px rgba(240, 192, 64, 0.75), 0 0 0 1.5px rgba(240, 192, 64, 1) inset, 0 0 10px rgba(255, 255, 255, 0.25); }
	}

	/* Fret number inside each note (0 = open string). */
	:global(.gh-fret) {
		font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
		font-size: 0.75rem;
		font-weight: 700;
		line-height: 1;
		color: rgba(255, 255, 255, 0.95);
		text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
		pointer-events: none;
		user-select: none;
	}

	.gh-count {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		font-size: 4rem;
		font-weight: 800;
		color: var(--ink);
		text-shadow: 0 0 20px var(--accent);
		pointer-events: none;
	}

	@media (min-width: 720px) {
		:global(.gh-note) { height: 26px; }
	}

	@media (max-width: 480px) {
		.gh-controls { flex-direction: column; align-items: stretch; }
		.gh-field { flex: 1; }
		.gh-field select { width: 100%; font-size: 1rem; padding: 0.6rem; }
		.gh-start { width: 100%; min-height: 48px; font-size: 1.1rem; }
		.gh-stage { height: 50vh; min-height: 280px; }
		:global(.gh-note) { height: 20px; }
	}
</style>
