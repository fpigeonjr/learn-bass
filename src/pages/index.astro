---
import Layout from '../layouts/Layout.astro';
import Tracker from '../components/Tracker.astro';
import { url } from '../lib/url';
import { songs } from '../data/songs';
import { computeCounts } from '../lib/queue';

// Counts scope to current (non-archived) songs; archiving is a per-browser
// concern, so this is the shipped baseline and Tracker re-renders it live.
const initial = computeCounts(songs);
---

<Layout title="Dashboard">
	<script>
	// Warm-up checklist persistence.
	const WARMUP_KEY = 'learn-bass:warmup:v1';
	function initWarmup() {
		const saved = JSON.parse(localStorage.getItem(WARMUP_KEY) || '{}');
		document.querySelectorAll('.checklist input').forEach((cb) => {
			cb.checked = !!saved[cb.dataset.k];
		});
	}
	function listenWarmup() {
		document.querySelectorAll('.checklist input').forEach((cb) => {
			cb.addEventListener('change', () => {
				const saved = JSON.parse(localStorage.getItem(WARMUP_KEY) || '{}');
				saved[cb.dataset.k] = cb.checked;
				localStorage.setItem(WARMUP_KEY, JSON.stringify(saved));
			});
		});
	}
	initWarmup();
	listenWarmup();

	// Stat-deck chips delegate filtering to the Tracker island, which owns
	// view state. Writing row.hidden here as well would fight it.
	let activeFilter: string | null = null;

	function applyFilter() {
		if (typeof window.__setStatusFilter === 'function') {
			window.__setStatusFilter(activeFilter);
		}
	}

	document.querySelectorAll('.stat-mini[data-filter]').forEach((chip) => {
		chip.addEventListener('click', () => {
			activeFilter = activeFilter === chip.dataset.filter ? null : chip.dataset.filter;
			applyFilter();
		});
	});
	const hash = (location.hash || '').replace('#', '');
	if (hash.startsWith('status=')) activeFilter = hash.slice(7);
	applyFilter();
</script>

<main class="wrap">
	<h1>Welcome back to the bass.</h1>
	<p class="lead">
		A standing queue of songs — the ones you already know, and the ones you're learning now.
		One at a time: roots, groove, and the hooks people recognize. No charts, no panic.
	</p>

	<div class="stat-deck">
		<div class="stat-card stat-card--hero">
			<div class="stat-card-head"><span class="fret-dot yellow"></span> Queue</div>
			<div id="queue-hero" class="queue-hero">
				<div class="num" id="count-current">{initial.current} <small>current</small></div>
				<div class="lbl"><span id="count-archived">{initial.archived}</span> archived</div>
			</div>
		</div>
		<div class="stat-card stat-card--group">
			<div class="stat-card-head">Status <span class="stat-hint">— click a chip to filter</span></div>
			<div class="stat-minis">
				<button class="stat-mini" data-filter="green" type="button"><i class="fret-dot green"></i><div class="num" id="count-green">{initial.byStatus.green}</div><div class="lbl">green</div><div class="sub">solid</div></button>
				<button class="stat-mini" data-filter="warm" type="button"><i class="fret-dot orange"></i><div class="num" id="count-warm">{initial.byStatus.warm}</div><div class="lbl">warm</div><div class="sub">needs reps</div></button>
				<button class="stat-mini" data-filter="dusty" type="button"><i class="fret-dot yellow"></i><div class="num" id="count-dusty">{initial.byStatus.dusty}</div><div class="lbl">dusty</div><div class="sub">rusty</div></button>
				<button class="stat-mini" data-filter="cold" type="button"><i class="fret-dot blue"></i><div class="num" id="count-cold">{initial.byStatus.cold}</div><div class="lbl">cold</div><div class="sub">not started</div></button>
			</div>
			<div class="stat-progress" aria-hidden="true"><span class="stat-progress-fill" id="gig-ready-fill" style={`width:${initial.greenPct}%`}></span></div>
			<div class="stat-progress-lbl"><span id="gig-ready-pct">{initial.greenPct}%</span> of your current queue is green</div>
		</div>
	</div>

	<div class="card next-card" id="what-now">
		<!-- populated by Tracker's script -->
	</div>

	<Tracker />

	<div class="card">
		<h2>Daily warm-up · 45-60 min</h2>
		<p><a class="btn-start" href={url("reference/warmups/")}>▶ Start Practice</a> <span class="muted">— launches the Guitar Hero play-along chart</span></p>
		<ul class="checklist">
			<li>
				<input type="checkbox" id="wu-0" data-k="0" />
				<span><span class="lbl">Stretch hands & forearms, spider 1-2-3-4</span> <span class="step">5 min</span></span>
			</li>
			<li>
				<input type="checkbox" id="wu-1" data-k="1" />
				<span><span class="lbl">Right-hand alternation + muted groove</span> <span class="step">5 min</span></span>
			</li>
			<li>
				<input type="checkbox" id="wu-2" data-k="2" />
				<span><span class="lbl">Scales / arpeggios with metronome</span> <span class="step">10 min</span></span>
			</li>
			<li>
				<input type="checkbox" id="wu-3" data-k="3" />
				<span><span class="lbl">Song work — loop the hard part</span> <span class="step">25 min</span></span>
			</li>
			<li>
				<input type="checkbox" id="wu-4" data-k="4" />
				<span><span class="lbl">Play something you love (Jude Law!)</span> <span class="step">5 min</span></span>
			</li>
		</ul>
	</div>
</main>
</Layout>
