---
import Layout from '../layouts/Layout.astro';
import Tracker from '../components/Tracker.astro';
import { url } from '../lib/url';
import { songs } from '../data/songs';
const greenCount = songs.filter((s) => s.status === 'green').length;
const warmCount = songs.filter((s) => s.status === 'warm').length;
const dustyCount = songs.filter((s) => s.status === 'dusty').length;
const coldCount = songs.filter((s) => s.status === 'cold').length;
const initialDays = Math.max(0, Math.ceil((new Date('2026-10-09T00:00:00-05:00').getTime() - Date.now()) / 86400000));
const gigReadyPct = Math.round((greenCount / songs.length) * 100);
---

<Layout title="Dashboard">
	<script>
	// Client-side countdown that updates live (island).
	const GIG = '2026-10-09T00:00:00-05:00';
	function tick() {
		const el = document.getElementById('countdown');
		const bar = document.getElementById('countdown-bar');
		const pctEl = document.getElementById('countdown-pct');
		const now = new Date();
		const target = new Date(GIG);
		now.setHours(0, 0, 0, 0);
		target.setHours(0, 0, 0, 0);
		const d = Math.ceil((target.getTime() - now.getTime()) / 86400000);
		if (d < 0) el.innerHTML = 'Gig done';
		else if (d === 0) el.innerHTML = "Tonight's the gig 🎸";
		else if (d === 1 || d === 2) el.innerHTML = 'Rest day — no practice';
		else el.innerHTML = `${d} <small>days</small>`;
		if (bar) {
			const total = 49; // ~7 weeks
			const pct = Math.max(4, Math.min(100, ((total - Math.max(0,d)) / total) * 100));
			bar.style.width = pct + '%';
		}
		if (pctEl) {
			const total = 49;
			const burned = Math.max(0, Math.min(100, Math.round(((total - Math.max(0,d)) / total) * 100)));
			pctEl.textContent = burned + '%';
		}
	}
	function init() {
		tick();
		setInterval(tick, 60_000);
	}
	init();

	// Warm-up checklist persistence.
	const WARMUP_KEY = 'learn-bass:warmup:v1';
	function initWarmup() {
		const saved = JSON.parse(localStorage.getItem(WARMUP_KEY) || '{}');
		document.querySelectorAll('.checklist input').forEach((cb) => {
			cb.checked = !!saved[cb.dataset.k];
		});
	}
	function listenWarmup() {
		document.querySelectorAll('.checklist input').forEach((cb) => {
			cb.addEventListener('change', () => {
				const saved = JSON.parse(localStorage.getItem(WARMUP_KEY) || '{}');
				saved[cb.dataset.k] = cb.checked;
				localStorage.setItem(WARMUP_KEY, JSON.stringify(saved));
			});
		});
	}
	initWarmup();
	listenWarmup();

	// Setlist status filter chips — click to filter the board.
	// The Tracker island owns board state; we surface filtering via URL hash
	// so it survives reloads and doesn't couple the two islands tightly.
	let activeFilter = null;
	function applyFilter() {
		const chips = document.querySelectorAll('.stat-mini[data-filter]');
		const rows = document.querySelectorAll('.board li');
		chips.forEach((chip) => {
			const on = chip.dataset.filter === activeFilter;
			chip.classList.toggle('is-active', on);
			chip.setAttribute('aria-pressed', String(on));
		});
		rows.forEach((row) => {
			const status = row.querySelector('.status')?.dataset.status;
			row.hidden = activeFilter && activeFilter !== 'all' ? status !== activeFilter : false;
		});
		const board = document.getElementById('tracker');
		if (board) board.setAttribute('data-filter', activeFilter || 'all');
	}
	window.__applyStatFilter = applyFilter;
	document.querySelectorAll('.stat-mini[data-filter]').forEach((chip) => {
		chip.addEventListener('click', () => {
			activeFilter = activeFilter === chip.dataset.filter ? null : chip.dataset.filter;
			applyFilter();
		});
	});
	const hash = (location.hash || '').replace('#', '');
	if (hash.startsWith('status=')) activeFilter = hash.slice(7);
	applyFilter();
</script>

<main class="wrap">
	<h1>Welcome back to the bass.</h1>
	<p class="lead">
		Seven weeks to a Friday-night gig, <span data-date>October 9, 2026 at Canyon Lake</span>. One song at a time —
		roots, groove, and the hooks people recognize. No charts, no panic.
	</p>

	<div class="stat-deck">
		<div class="stat-card stat-card--hero">
			<div class="stat-card-head"><span class="fret-dot yellow"></span> Countdown</div>
			<div class="num" id="countdown">{initialDays} <small>days</small></div>
			<div class="lbl">until the gig — Oct 9 · Canyon Lake</div>
			<div class="bar" aria-hidden="true"><i id="countdown-bar"></i><span class="bar-notch" style="left:33.3%"></span><span class="bar-notch" style="left:66.6%"></span></div>
			<div class="countdown-sub"><span id="countdown-pct">0%</span> of the runway burned</div>
		</div>
		<div class="stat-card stat-card--group">
			<div class="stat-card-head">Setlist status <span class="stat-hint">— click a chip to filter</span></div>
			<div class="stat-minis">
				<button class="stat-mini" data-filter="green" type="button"><i class="fret-dot green"></i><div class="num" id="count-green">{greenCount}</div><div class="lbl">green</div><div class="sub">gig-ready</div></button>
				<button class="stat-mini" data-filter="warm" type="button"><i class="fret-dot orange"></i><div class="num" id="count-warm">{warmCount}</div><div class="lbl">warm</div><div class="sub">needs reps</div></button>
				<button class="stat-mini" data-filter="dusty" type="button"><i class="fret-dot yellow"></i><div class="num" id="count-dusty">{dustyCount}</div><div class="lbl">dusty</div><div class="sub">rusty</div></button>
				<button class="stat-mini" data-filter="cold" type="button"><i class="fret-dot blue"></i><div class="num" id="count-cold">{coldCount}</div><div class="lbl">cold</div><div class="sub">not started</div></button>
			</div>
			<div class="stat-progress" aria-hidden="true"><span class="stat-progress-fill" id="gig-ready-fill" style={`width:${gigReadyPct}%`}></span></div>
			<div class="stat-progress-lbl"><span id="gig-ready-pct">{gigReadyPct}%</span> of the set is gig-ready</div>
		</div>
	</div>

	<div class="card next-card" id="what-now">
		<!-- populated by Tracker's script -->
	</div>

	<Tracker />

	<div class="card">
		<h2>Daily warm-up · 45-60 min</h2>
		<p><a class="btn-start" href={url("reference/warmups/")}>▶ Start Practice</a> <span class="muted">— launches the Guitar Hero play-along chart</span></p>
		<ul class="checklist">
			<li>
				<input type="checkbox" id="wu-0" data-k="0" />
				<span><span class="lbl">Stretch hands & forearms, spider 1-2-3-4</span> <span class="step">5 min</span></span>
			</li>
			<li>
				<input type="checkbox" id="wu-1" data-k="1" />
				<span><span class="lbl">Right-hand alternation + muted groove</span> <span class="step">5 min</span></span>
			</li>
			<li>
				<input type="checkbox" id="wu-2" data-k="2" />
				<span><span class="lbl">Scales / arpeggios with metronome</span> <span class="step">10 min</span></span>
			</li>
			<li>
				<input type="checkbox" id="wu-3" data-k="3" />
				<span><span class="lbl">Song work — loop the hard part</span> <span class="step">25 min</span></span>
			</li>
			<li>
				<input type="checkbox" id="wu-4" data-k="4" />
				<span><span class="lbl">Play something you love (Jude Law!)</span> <span class="step">5 min</span></span>
			</li>
		</ul>
	</div>
</main>
</Layout>
